# Copy to .moodle.env. This file is ignored and must contain real local secrets.
MOODLE_BRANCH=MOODLE_405_STABLE
MOODLE_HTTP_PORT=8088
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=replace-with-a-long-random-password
MOODLE_DB_ROOT_PASSWORD=replace-with-a-different-long-random-password
