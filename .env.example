# Copy this file to .env and supply local values. Never commit real secrets.

# LMS backend and SQL Server
LMS_FASTAPI_URL=http://127.0.0.1:8000
# Moodle query/chat accepts a personal user Bearer token; enable site_info and get_users_courses in Moodle.
MOODLE_BASE_URL=
# Separate Moodle service credential for exact manageactivities evidence; never a student credential.
MOODLE_CAPABILITY_SERVICE_TOKEN=
# Shared only by the local FastAPI and Streamlit server processes; never expose it to browsers.
LMS_MOODLE_DISCOVERY_TOKEN=
LMS_DB_SERVER=localhost
LMS_DB_NAME=LMS_DeepTutor
LMS_DB_DRIVER=ODBC Driver 17 for SQL Server
LMS_UPLOAD_DIR=
LMS_DB_QUERY_TIMEOUT_SECONDS=10
LMS_DB_LOCK_TIMEOUT_MS=10000

# Optional DeepTutor path overrides. Defaults resolve from the repository root.
DEEPTUTOR_DIR=
DEEPTUTOR_EXE=

# Local demo-account tokens are not configured through this file. The Windows
# launcher shows the account chooser, but each developer must create their own
# per-user DPAPI blobs with lms-dlu-demo\provision_demo_accounts.ps1.
# Optional: set DEMO_DPAPI_SECRET_DIR to a local directory containing those blobs.
DEMO_DPAPI_SECRET_DIR=

# Optional launcher override
LMS_VENV_DIR=

# Optional LLM benchmark targets. Cloud document content remains disabled unless
# the benchmark ModelConfig explicitly sets allow_cloud_document_content=True.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
AI_TUTOR_TOP_K=3
# Quiz/Flashcard only: backend deadline, retrieval share, persistence reserve, then UI deadline.
LEARNING_GENERATION_PROVIDER=ollama
# Ollama default: qwen2.5:3b. Groq default: qwen/qwen3.8-27b.
LEARNING_GENERATION_MODEL=
LEARNING_GENERATION_PROVIDER_TIMEOUT_SECONDS=120
LEARNING_REQUEST_TIMEOUT_SECONDS=150
LEARNING_RETRIEVAL_TIMEOUT_SECONDS=60
LEARNING_PERSISTENCE_RESERVE_SECONDS=20
LEARNING_CLIENT_TIMEOUT_SECONDS=170
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
